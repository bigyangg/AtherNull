{
  "name": "@athernull/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@athernull/contracts": "workspace:*",
    "@athernull/database": "workspace:*",
    "@athernull/model-router": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "better-auth": "^1.7.5",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
