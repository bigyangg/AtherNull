# Copy to .env (gitignored, never commit the real file).

# Matches infrastructure/docker-compose.yml's local dev Postgres (port 5433 —
# not the default 5432, since this machine already runs an unrelated
# project's Postgres container on 5432).
DATABASE_URL=postgres://athernull:athernull@localhost:5433/athernull_dev

# Better Auth reads these two directly from the environment.
# Generate a real secret: at least 32 chars, high entropy — e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
