# Copy to .env (gitignored, never commit the real file).

# Matches infrastructure/docker-compose.yml's local dev Postgres (port 5433 —
# not the default 5432, since this machine already runs an unrelated
# project's Postgres container on 5432).
DATABASE_URL=postgres://athernull:athernull@localhost:5433/athernull_dev

# Better Auth reads these two directly from the environment.
# Generate a real secret: at least 32 chars, high entropy — e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The web app's origin. Used to (a) build links in auth emails that land on
# the web app's own pages (e.g. /reset-password), and (b) as the default for
# TRUSTED_ORIGINS/CORS below.
WEB_APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API with credentials
# (CORS) and to be used as callbackURL/redirectTo targets (Better Auth's
# origin check). Defaults to WEB_APP_URL if unset. In production this should
# be the real web app origin(s), e.g. https://app.athernull.io
TRUSTED_ORIGINS=

# Only needed in production when the web and api apps share a parent domain
# (e.g. app.athernull.io / api.athernull.io) and the session cookie must be
# sent to both. Leave unset in local dev.
COOKIE_DOMAIN=

# Resend (SMTP is live for athernull.io — see the Resend dashboard).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="AtherNull <auth@athernull.io>"

# Phase 1 core job engine (PLAN.md §2). Shared secret for /internal/* —
# the worker's credential, deliberately separate from Better Auth sessions
# (a worker has no user). Generate the same way as BETTER_AUTH_SECRET above.
INTERNAL_API_TOKEN=

# How long a worker's claim on an execution is valid before another worker
# may reclaim it as orphaned (a crashed/restarted worker). Seconds.
EXECUTION_LEASE_SECONDS=300
