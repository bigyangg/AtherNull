# Copy to .env (gitignored, never commit the real file).

# Matches infrastructure/docker-compose.yml's local dev Postgres (port 5433 —
# not the default 5432, since this machine already runs an unrelated
# project's Postgres container on 5432).
DATABASE_URL=postgres://athernull:athernull@localhost:5433/athernull_dev

# Better Auth reads these two directly from the environment.
# Generate a real secret: at least 32 chars, high entropy — e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The web app's origin. Used to (a) build links in auth emails that land on
# the web app's own pages (e.g. /reset-password), and (b) as the default for
# TRUSTED_ORIGINS/CORS below.
WEB_APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API with credentials
# (CORS) and to be used as callbackURL/redirectTo targets (Better Auth's
# origin check). Defaults to WEB_APP_URL if unset. In production this should
# be the real web app origin(s), e.g. https://app.athernull.io
TRUSTED_ORIGINS=

# Only needed in production when the web and api apps share a parent domain
# (e.g. app.athernull.io / api.athernull.io) and the session cookie must be
# sent to both. Leave unset in local dev.
COOKIE_DOMAIN=

# Resend (SMTP is live for athernull.io — see the Resend dashboard).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="AtherNull <auth@athernull.io>"

# Phase 1 core job engine (PLAN.md §2). Shared secret for /internal/* —
# the worker's credential, deliberately separate from Better Auth sessions
# (a worker has no user). Generate the same way as BETTER_AUTH_SECRET above.
INTERNAL_API_TOKEN=

# How long a worker's claim on an execution is valid before another worker
# may reclaim it as orphaned (a crashed/restarted worker). Seconds.
EXECUTION_LEASE_SECONDS=300

# Phase 4E.1 — Solana DEVNET project funding (docs/adr/0013-solana-devnet-project-funding.md).
# Funding fails closed unless SOLANA_NETWORK is exactly "devnet". The RPC URL
# carries the Helius API key: server-side only — never expose it to the
# browser, the worker/OpenHands, logs or task prompts. Use the Helius DEVNET
# endpoint, never the mainnet one (the chain's genesis hash is also verified).
SOLANA_NETWORK=devnet
SOLANA_RPC_PROVIDER=helius
SOLANA_RPC_URL=
SOLANA_FUNDING_PROGRAM_ID=9isSF5USV3WURyJaKLtvcd82W2txUQnFDaRz6WK8Vcjv
# Devnet-only platform authority (signs initialize_project_funding; pays rent).
# JSON byte array of the 64-byte secret key. Never commit, never give to workers.
SOLANA_AUTHORITY_KEYPAIR=
# Optional; derived from the keypair when omitted.
SOLANA_AUTHORITY_PUBKEY=
# DEMO_FIXED funding requirement in lamports (integer). Not derived from the
# budget authorization, NIM usage, USD or any SOL price.
SOLANA_DEMO_REQUIRED_LAMPORTS=50000000

# Phase 4A planner (scope/plan generation). Uses Anthropic when
# ANTHROPIC_API_KEY is set, otherwise NVIDIA NIM when NVIDIA_NIM_API_KEY is
# set; PLANNER_PROVIDER ("anthropic" | "nvidia_nim") forces one.
ANTHROPIC_API_KEY=
NVIDIA_NIM_API_KEY=
PLANNER_PROVIDER=
# Optional NIM model override (default nvidia/nemotron-3-super-120b-a12b).
PLANNER_NIM_MODEL=
# The model every funded build runs with (any LiteLLM model string, e.g.
# nvidia_nim/nvidia/nemotron-3-super-120b-a12b or an openrouter/... model;
# the worker needs that provider's key). Unset: an NVIDIA-only deployment
# (NVIDIA_NIM_API_KEY, no ANTHROPIC_API_KEY) uses its NIM model; otherwise
# each organization's agent profile decides (routing.ts).
AGENT_MODEL=
# Phase 4E.2: provider payout wallet that receives the released amount when a
# build is accepted. Defaults to the platform authority's pubkey.
SOLANA_SETTLEMENT_RECIPIENT=

# ADR-0017 independent verifier's credential (services/verifier). Must differ
# from INTERNAL_API_TOKEN: a worker must never be able to report a verdict.
VERIFIER_API_TOKEN=

# Workspace onboarding (docs/architecture/WORKSPACE_ONBOARDING.md), read by
# the sandbox provisioner and the API:
# SANDBOX_WARM_POOL_SIZE=1            # pre-booted spare workspaces (0 disables); ~0.3-0.5 GB RAM each while idle
# SANDBOX_PROVISIONER_CONCURRENCY=2   # workspaces set up side by side
# SANDBOX_MAX_RUNNING=50              # hard cap on sandboxes (organizations' + pool's); size to the host's RAM
# SANDBOX_MAX_PER_USER=3              # workspace requests one user may hold across organizations
