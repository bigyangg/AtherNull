@@ -0,0 +1,53 @@
+import React from "react";
+
+// AtherNull: the chat-native build card (plan -> approve -> bill -> pay ->
+// build -> review). The card itself is AtherNull's page /chat-build/<id>,
+// framed from the same origin so the session cookie and every server-side
+// check apply; it reports its height, and stays hidden for conversations
+// that aren't AtherNull discussions (it reports no height then).
+export function AtherNullBuildCard({
+  conversationId,
+}: {
+  conversationId: string | null | undefined;
+}) {
+  const [height, setHeight] = React.useState(0);
+
+  React.useEffect(() => {
+    setHeight(0);
+    const onMessage = (event: MessageEvent) => {
+      if (event.origin !== window.location.origin) return;
+      const data = event.data as
+        | { type?: string; discussionId?: string; height?: number }
+        | undefined;
+      if (
+        data?.type === "athernull:chat-build" &&
+        data.discussionId === conversationId &&
+        typeof data.height === "number"
+      ) {
+        setHeight(data.height);
+      }
+    };
+    window.addEventListener("message", onMessage);
+    return () => window.removeEventListener("message", onMessage);
+  }, [conversationId]);
+
+  if (!import.meta.env.VITE_ATHERNULL || !conversationId) return null;
+  const visible = height > 16;
+  return (
+    <iframe
+      key={conversationId}
+      title="AtherNull build"
+      src={`/chat-build/${encodeURIComponent(conversationId)}`}
+      data-testid="athernull-build-card"
+      style={{
+        display: "block",
+        width: "100%",
+        height: visible ? height : 0,
+        border: 0,
+        background: "transparent",
+        colorScheme: "normal",
+      }}
+      aria-hidden={!visible}
+    />
+  );
+}
