--- /dev/null
+++ b/src/routes/athernull-not-found.tsx
@@ -0,0 +1,10 @@
+// AtherNull: any address the canvas has no page for. Throwing a 404 hands it
+// to the layout's error boundary, which shows the designed "This page doesn't
+// exist" screen with a way back (routes/root-layout.tsx).
+export async function clientLoader(): Promise<never> {
+  throw new Response("Not Found", { status: 404 });
+}
+
+export default function NotFound() {
+  return null;
+}
