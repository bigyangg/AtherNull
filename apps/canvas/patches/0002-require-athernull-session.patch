+// AtherNull: the canvas's backend is AtherNull's agent gateway, which
+// authenticates the AtherNull session cookie. Without a session, send the
+// user to AtherNull sign-in (and back here) instead of letting the canvas
+// report a disconnected backend.
+async function requireAtherNullSession() {
+  const sessionUrl = import.meta.env.VITE_ATHERNULL_SESSION_URL;
+  if (!sessionUrl) return;
+  let signedIn = false;
+  try {
+    const res = await fetch(sessionUrl, { credentials: "same-origin" });
+    signedIn = res.ok && (await res.json()) !== null;
+  } catch {
+    signedIn = false;
+  }
+  if (!signedIn) {
+    const back = `${window.location.pathname}${window.location.search}`;
+    window.location.assign(`/sign-in?callbackURL=${encodeURIComponent(back)}`);
+    await new Promise(() => {});
+  }
+  if (import.meta.env.VITE_ATHERNULL_SANDBOX_URL) {
+    await ensureActiveOrganization();
+    await ensureAgentWorkspace(import.meta.env.VITE_ATHERNULL_SANDBOX_URL);
+  }
+}
+
+// JSON content-type only with a body: Fastify rejects an empty JSON body.
+const sameOrigin = (url: string, init: RequestInit = {}) =>
+  fetch(url, {
+    credentials: "same-origin",
+    ...init,
+    headers: { ...(init.body ? { "content-type": "application/json" } : {}), ...(init.headers ?? {}) },
+  });
+
+// A new account has no organization yet: use one the user already belongs
+// to, or create their personal workspace.
+async function ensureActiveOrganization() {
+  const session = await (await sameOrigin("/api/auth/get-session")).json().catch(() => null);
+  if (session?.session?.activeOrganizationId) return;
+  const orgs: { id: string }[] = await (await sameOrigin("/api/auth/organization/list")).json().catch(() => []);
+  if (orgs.length > 0) {
+    await sameOrigin("/api/auth/organization/set-active", { method: "POST", body: JSON.stringify({ organizationId: orgs[0]!.id }) });
+    return;
+  }
+  const name = session?.user?.name ? `${session.user.name}'s workspace` : "My workspace";
+  const slug = `ws-${crypto.randomUUID().slice(0, 8)}`;
+  await sameOrigin("/api/auth/organization/create", { method: "POST", body: JSON.stringify({ name, slug }) });
+}
+
+// The organization's agent workspace (sandbox) is created on demand by
+// AtherNull's provisioner; show a setup screen until it is ready.
+async function ensureAgentWorkspace(stateUrl: string) {
+  const read = async () => (await sameOrigin(stateUrl)).json() as Promise<{ status: string; error: string | null }>;
+  let state = await read().catch(() => ({ status: "NONE", error: null }));
+  if (state.status === "READY") return;
+  const screen = setupScreen();
+  for (;;) {
+    if (state.status === "NONE" || state.status === "FAILED") {
+      if (state.status === "FAILED") {
+        await screen.failed(state.error ?? "Workspace setup failed.");
+      }
+      const res = await sameOrigin(stateUrl, { method: "POST" }).catch(() => null);
+      const body = res ? await res.json().catch(() => null) : null;
+      state = res?.ok && body?.status ? body : { status: "FAILED", error: body?.error ?? "Could not request a workspace." };
+      if (state.status === "FAILED") continue;
+    }
+    if (state.status === "READY") {
+      window.location.reload();
+      await new Promise(() => {});
+    }
+    screen.progress(state.status);
+    await new Promise((resolve) => setTimeout(resolve, 2000));
+    state = await read().catch(() => state);
+  }
+}
+
+function setupScreen() {
+  const root = document.createElement("div");
+  root.style.cssText =
+    "position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;background:#0d0d0f;color:#f2f2f0;font:14px/1.5 ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif";
+  root.innerHTML = `
