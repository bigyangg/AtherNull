+      <img src="${import.meta.env.BASE_URL}favicon.svg" alt="" width="40" height="40" style="margin:0 auto 20px;display:block" />
+      <div style="font-size:18px;font-weight:600">Setting up your workspace</div>
+      <div data-detail style="margin-top:8px;color:#8b8b8f">Starting your private agent sandbox. This takes about a minute the first time.</div>
+      <div style="margin:24px auto 0;height:3px;width:160px;overflow:hidden;border-radius:3px;background:#232326">
+        <div style="height:100%;width:40%;background:#f2f2f0;border-radius:3px;animation:athernull-slide 1.2s ease-in-out infinite"></div>
+      </div>
+      <button data-retry style="display:none;margin:20px auto 0;padding:8px 14px;border-radius:8px;border:0;background:#f2f2f0;color:#141414;font-weight:600;cursor:pointer">Try again</button>
+    </div>
+    <style>@keyframes athernull-slide{0%{transform:translateX(-100%)}100%{transform:translateX(250%)}}</style>`;
+  document.body.append(root);
+  const detail = root.querySelector<HTMLElement>("[data-detail]")!;
+  const retry = root.querySelector<HTMLButtonElement>("[data-retry]")!;
+  return {
+    progress(status: string) {
+      retry.style.display = "none";
+      detail.textContent =
+        status === "PROVISIONING"
+          ? "Starting your private agent sandbox and installing AtherNull Builds…"
+          : "Starting your private agent sandbox. This takes about a minute the first time.";
+    },
+    failed(message: string) {
+      detail.textContent = `Setup failed: ${message}`;
+      retry.style.display = "block";
+      return new Promise<void>((resolve) => retry.addEventListener("click", () => resolve(), { once: true }));
+    },
+  };
+}
