diff --git a/src/components/features/sidebar/athernull-checklist.tsx b/src/components/features/sidebar/athernull-checklist.tsx
new file mode 100644
index 0000000..a5e639f
--- /dev/null
+++ b/src/components/features/sidebar/athernull-checklist.tsx
@@ -0,0 +1,123 @@
+import { useQuery } from "@tanstack/react-query";
+import { Check, ChevronDown } from "lucide-react";
+import { useState } from "react";
+import { NavigationLink } from "#/components/shared/navigation-link";
+import { usePaginatedConversations } from "#/hooks/query/use-paginated-conversations";
+import { cn } from "#/utils/utils";
+
+// AtherNull: the getting-started steps are AtherNull's own flow — talk to the
+// agent, turn it into a build, fund it, review the result — instead of the
+// upstream LLM / MCP / Slack checklist.
+
+const BUILDS_PAGE = "/extensions/athernull/builds";
+const MINIMIZED_KEY = "athernull-checklist-minimized";
+const FUNDED = new Set([
+  "FUNDED", "QUEUED", "RUNNING", "VERIFYING", "AWAITING_ACCEPTANCE", "ACCEPTED",
+  "SETTLING", "SETTLED", "REJECTED", "DISPUTED", "REFUNDING", "REFUNDED", "PAUSED_USAGE_LIMIT",
+]);
+const REVIEWED = new Set(["ACCEPTED", "SETTLING", "SETTLED", "REJECTED", "REFUNDING", "REFUNDED"]);
+
+interface BuildItem {
+  kind: "draft" | "build";
+  status: string;
+}
+
+function readMinimized(): boolean {
+  try {
+    return window.localStorage.getItem(MINIMIZED_KEY) === "1";
+  } catch {
+    return false;
+  }
+}
+
+export function AtherNullChecklist({ collapsed }: { collapsed: boolean }) {
+  const [minimized, setMinimized] = useState(readMinimized);
+  const { data: conversationPage } = usePaginatedConversations(1);
+  const { data: builds } = useQuery({
+    queryKey: ["athernull", "builds"],
+    queryFn: async (): Promise<BuildItem[]> => {
+      const res = await fetch("/v1/builds", { credentials: "same-origin" });
+      if (!res.ok) throw new Error(`builds ${res.status}`);
+      const body = await res.json();
+      return Array.isArray(body) ? body : (body.builds ?? []);
+    },
+    refetchInterval: 30_000,
+    meta: { disableToast: true },
+  });
+
+  const list = builds ?? [];
+  const steps = [
+    { label: "Talk to the agent", to: "/", done: (conversationPage?.pages[0]?.items.length ?? 0) > 0 },
+    { label: "Turn it into a build", to: BUILDS_PAGE, done: list.length > 0 },
+    { label: "Fund the build", to: BUILDS_PAGE, done: list.some((b) => b.kind === "build" && FUNDED.has(b.status)) },
+    { label: "Review and accept", to: BUILDS_PAGE, done: list.some((b) => b.kind === "build" && REVIEWED.has(b.status)) },
+  ];
+  const completed = steps.filter((s) => s.done).length;
+
+  if (collapsed || builds === undefined || completed === steps.length) return null;
+
+  const toggle = () => {
+    setMinimized((current) => {
+      try {
+        window.localStorage.setItem(MINIMIZED_KEY, current ? "0" : "1");
+      } catch {
+        // best-effort
+      }
+      return !current;
+    });
+  };
+
+  return (
+    <div
+      data-testid="athernull-checklist"
+      className="w-full shrink-0 overflow-hidden rounded-xl border border-border bg-surface-raised shadow-sm"
+    >
+      <div className={cn("px-1", minimized ? "py-1" : "pt-2 pb-1")}>
+        <button
+          type="button"
+          aria-expanded={!minimized}
+          onClick={toggle}
+          className={cn(
+            "flex w-full cursor-pointer items-center gap-2 rounded-md px-2 text-left transition-colors hover:bg-surface",
+            minimized ? "py-1" : "py-1.5",
+          )}
+        >
+          <span className="text-sm font-semibold text-content">Getting started</span>
+          <span className="text-xs text-muted">
+            {completed} of {steps.length}
+          </span>
+          <ChevronDown
+            aria-hidden
+            className={cn("ml-auto size-4 text-muted transition-transform", minimized && "-rotate-90")}
+          />
+        </button>
+      </div>
+      {!minimized ? (
+        <ol className="flex flex-col gap-0.5 px-2.5 pb-2">
+          {steps.map((step) => (
+            <li key={step.label}>
+              <NavigationLink
+                to={step.to}
+                className={cn(
+                  "flex min-w-0 w-full items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm transition-colors hover:bg-surface",
+                  step.done ? "text-muted" : "text-content",
+                )}
+              >
+                <span
+                  aria-hidden
+                  className={cn(
+                    "inline-flex size-4 shrink-0 items-center justify-center rounded-full border",
+                    step.done ? "border-primary bg-primary text-on-primary" : "border-border bg-transparent",
+                  )}
+                >
+                  {step.done ? <Check className="size-2.5" strokeWidth={3} /> : null}
+                </span>
+                <span className={cn("min-w-0 flex-1 truncate", step.done && "line-through")}>{step.label}</span>
+              </NavigationLink>
+            </li>
+          ))}
+        </ol>
+      ) : null}
+    </div>
+  );
+}
