@@ -0,0 +1,31 @@
+import { useQuery } from "@tanstack/react-query";
+import { BackendStatusDot } from "#/components/features/backends/backend-status-dot";
+
+// AtherNull: the canvas always talks to the organization's own workspace
+// through AtherNull's gateway, so there is no backend to pick or add — the
+// footer just names the workspace and shows whether it is reachable.
+export function AtherNullWorkspaceTile({ isConnected }: { isConnected: boolean | null }) {
+  const { data: name } = useQuery({
+    queryKey: ["athernull", "workspace-name"],
+    queryFn: async () => {
+      const res = await fetch("/api/auth/organization/get-full-organization", { credentials: "same-origin" });
+      const org = res.ok ? await res.json() : null;
+      return (org?.name as string | undefined) ?? "Your workspace";
+    },
+    staleTime: Infinity,
+    meta: { disableToast: true },
+  });
+
+  return (
+    <div
+      data-testid="athernull-workspace-tile"
+      title={isConnected === false ? "Workspace unreachable" : "Workspace ready"}
+      className="flex min-w-0 items-center gap-2.5 rounded-md px-2.5 py-2 text-sm text-content"
+    >
+      <span className="relative inline-flex size-2 shrink-0">
+        <BackendStatusDot isConnected={isConnected} className="static" />
+      </span>
+      <span className="min-w-0 flex-1 truncate">{name ?? "Your workspace"}</span>
+    </div>
+  );
+}
