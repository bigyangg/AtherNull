diff --git a/src/utils/athernull-catalog.ts b/src/utils/athernull-catalog.ts
new file mode 100644
index 0000000..dd9c3c8
--- /dev/null
+++ b/src/utils/athernull-catalog.ts
@@ -0,0 +1,39 @@
+// AtherNull: the skills and plugins catalogs come from the public OpenHands
+// extensions registry. Entries about the OpenHands platform itself (its SDK,
+// Cloud, Enterprise, REST API) mean nothing to an AtherNull user and are
+// hidden; generic entries stay, with their copy and sandbox paths shown in
+// AtherNull terms. Only display text changes — names and sources used to
+// install or enable an entry are left as they are.
+
+const ATHERNULL = Boolean(import.meta.env.VITE_ATHERNULL);
+
+const PLATFORM_ENTRY =
+  /openhands[\s-]*(software agent )?(sdk|cloud|enterprise|api|automation|agent sdk)|all-hands|agent canvas|\bOHE\b/i;
+
+export function isHiddenCatalogEntry(name: string, description?: string | null): boolean {
+  if (!ATHERNULL) return false;
+  return /openhands|agent-canvas/i.test(name) || PLATFORM_ENTRY.test(description ?? "");
+}
+
+/** Catalog copy in AtherNull terms. */
+export function catalogText<T extends string | null | undefined>(text: T): T {
+  if (!ATHERNULL || !text) return text;
+  return text.replace(/\bOpen ?Hands\b/gi, "AtherNull") as T;
+}
+
+/** The catalog an AtherNull user sees: platform entries hidden, copy rebranded. */
+export function brandCatalog<T extends { name: string; description?: string | null }>(entries: T[]): T[] {
+  if (!ATHERNULL) return entries;
+  return entries
+    .filter((entry) => !isHiddenCatalogEntry(entry.name, entry.description))
+    .map((entry) => ({ ...entry, description: catalogText(entry.description) }));
+}
+
+/** Where an entry lives, without the sandbox's internal cache path. */
+export function catalogSource<T extends string | null | undefined>(source: T): T {
+  if (!ATHERNULL || !source) return source;
+  return source
+    .replace(/^\/home\/[^/]+\/\.openhands\/cache\/skills\/public-skills\//, "registry/")
+    .replace(/^\/home\/[^/]+\/\.openhands\//, "~/")
+    .replace(/OpenHands\/extensions/g, "extensions") as T;
+}
