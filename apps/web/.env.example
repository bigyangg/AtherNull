# Copy to .env.local (gitignored, never commit the real file).

# apps/api's own origin — the Better Auth client calls this directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pre-launch flag (see proxy.ts): "true" redirects every route except "/"
# back to the landing page. Leave unset locally; set on the VPS deployment
# until apps/api is live there too and sign-in/projects actually work.
LANDING_ONLY_MODE=
