# Copy to .env.local (gitignored, never commit the real file).

# apps/api's own origin — the Better Auth client calls this directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pre-launch flag (see proxy.ts): "true" keeps account/product routes closed,
# but leaves public marketing, documentation, legal, contact, and waitlist
# pages available. Leave unset locally; set on the VPS until apps/api is live.
LANDING_ONLY_MODE=

# /waitlist signups (app/api/waitlist/route.ts) — stored as Resend contacts,
# no database required. Same Resend account as apps/api's auth email, but a
# dedicated audience: create one at https://resend.com/audiences and paste
# its id below.
RESEND_API_KEY=
RESEND_WAITLIST_AUDIENCE_ID=
