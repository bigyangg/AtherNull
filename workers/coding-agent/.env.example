# Copy to .env (gitignored, never commit the real file) and fill in your key.
#
# Pick any LiteLLM-style model string — not locked to Anthropic. Examples:
#   anthropic/claude-sonnet-5
#   openai/gpt-5
#   gemini/gemini-3-pro
#   openrouter/<vendor>/<model>
#   nvidia_nim/qwen/qwen3-coder-480b-a35b-instruct   (NVIDIA Build, agentic-coding tuned)
#   ollama/<model>          (local runtime, no key needed)
LLM_MODEL=anthropic/claude-sonnet-5

# Either set LLM_API_KEY (always wins, works for any provider)...
LLM_API_KEY=sk-...

# ...or set the provider-specific var matching LLM_MODEL's prefix instead, e.g.:
# OPENAI_API_KEY=sk-...
# NVIDIA_NIM_API_KEY=nvapi-...   (key from build.nvidia.com/settings/api-keys)
